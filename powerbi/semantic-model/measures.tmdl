createOrReplace

	table _Measures

		/// Number of valid, non-cancelled work orders created in the selected period.
		measure 'Work Orders' = COUNTROWS ( 'Work Orders' )
			formatString: #,0
			displayFolder: 01 Volume

		/// Reactive work orders (Corrective + Emergency). Denominator for MTBF, FTF and PM ratio.
		measure 'Failure Work Orders' = CALCULATE ( [Work Orders], 'Work Orders'[Is Failure] = TRUE () )
			formatString: #,0
			displayFolder: 01 Volume

		/// Planned preventive maintenance work orders.
		measure 'Preventive Work Orders' = CALCULATE ( [Work Orders], 'Work Orders'[Work Order Type] = "Preventive" )
			formatString: #,0
			displayFolder: 01 Volume

		/// Priority-1 emergency call-outs.
		measure 'Emergency Work Orders' = CALCULATE ( [Work Orders], 'Work Orders'[Work Order Type] = "Emergency" )
			formatString: #,0
			displayFolder: 01 Volume

		/// Work orders that are Open or In Progress (snapshot, ignores the date filter).
		measure 'Open Backlog' =
				CALCULATE (
				    [Work Orders],
				    'Work Orders'[Status] IN { "Open", "In Progress" },
				    REMOVEFILTERS ( 'Date' )
				)
			formatString: #,0
			displayFolder: 01 Volume

		/// Labour cost + material cost of work orders created in the period (EUR).
		measure 'Maintenance Cost' = SUM ( 'Work Orders'[Maintenance Cost] )
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Labour hours x technician hourly rate (EUR).
		measure 'Labor Cost' = SUM ( 'Work Orders'[Labor Cost] )
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Spare parts and consumables (EUR).
		measure 'Material Cost' = SUM ( 'Work Orders'[Material Cost] )
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Estimated production loss = downtime hours x EUR/hour rate by asset criticality (A 1,200 / B 450 / C 150), approved by Controlling.
		measure 'Downtime Cost' = SUM ( 'Work Orders'[Downtime Cost] )
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Maintenance cost + downtime cost. The KPI that makes preventive maintenance comparable with reactive repair.
		measure 'Total Cost of Ownership' = [Maintenance Cost] + [Downtime Cost]
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Maintenance cost divided by the number of current assets in scope.
		measure 'Cost per Asset' = DIVIDE ( [Maintenance Cost], [Asset Count] )
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Total cost of ownership divided by the number of current assets in scope.
		measure 'TCO per Asset' = DIVIDE ( [Total Cost of Ownership], [Asset Count] )
			formatString: #,0 €
			displayFolder: 02 Cost

		/// Approved monthly maintenance budget (EUR). Granularity is month x site.
		measure 'Budget' = SUM ( 'Budget'[Budget Amount] )
			formatString: #,0 €
			displayFolder: 03 Budget

		/// Maintenance cost minus budget. Positive = overrun.
		measure 'Budget Variance' = IF ( NOT ISBLANK ( [Budget] ), [Maintenance Cost] - [Budget] )
			formatString: +#,0 €;-#,0 €;0 €
			displayFolder: 03 Budget

		/// Maintenance cost / budget - 1. Positive = overrun.
		measure 'Budget Variance %' = IF ( NOT ISBLANK ( [Budget] ), DIVIDE ( [Maintenance Cost], [Budget] ) - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: 03 Budget

		/// Linear run-rate forecast for the full calendar year of the last loaded date (YTD actual / elapsed days x days in year).
		measure 'Maintenance Cost Forecast FY' =
				VAR _lastDate = CALCULATE ( MAX ( 'Work Orders'[Created Date] ), REMOVEFILTERS ( 'Date' ) )
				VAR _yearStart = DATE ( YEAR ( _lastDate ), 1, 1 )
				VAR _yearEnd = DATE ( YEAR ( _lastDate ), 12, 31 )
				VAR _ytd = CALCULATE ( [Maintenance Cost], DATESBETWEEN ( 'Date'[Date], _yearStart, _lastDate ) )
				VAR _elapsedDays = INT ( _lastDate - _yearStart ) + 1
				VAR _daysInYear = INT ( _yearEnd - _yearStart ) + 1
				RETURN
				    DIVIDE ( _ytd, _elapsedDays ) * _daysInYear
			formatString: #,0 €
			displayFolder: 03 Budget

		/// Hex colour for conditional formatting (field value). Green on/under budget, amber up to +5 %, red above.
		measure 'Budget Status Color' =
				VAR _v = [Budget Variance %]
				RETURN
				    SWITCH (
				        TRUE (),
				        ISBLANK ( _v ), "#8A8F98",
				        _v > 0.05, "#C0392B",
				        _v > 0, "#D68910",
				        "#1E8449"
				    )
			displayFolder: 03 Budget

		/// Number of distinct current assets in scope. Site/Region filters are transferred with TREATAS because Asset is not related to Site (avoids an ambiguous model).
		measure 'Asset Count' =
				CALCULATE (
				    DISTINCTCOUNT ( 'Asset'[Asset ID] ),
				    'Asset'[Is Current] = TRUE (),
				    TREATAS ( VALUES ( 'Site'[Site ID] ), 'Asset'[Site ID] )
				)
			formatString: #,0
			displayFolder: 04 Reliability

		/// Calendar hours in the selected period, capped at the last loaded date.
		measure 'Hours in Period' =
				VAR _lastDataDate = CALCULATE ( MAX ( 'Work Orders'[Created Date] ), REMOVEFILTERS () )
				VAR _start = MIN ( 'Date'[Date] )
				VAR _end = MIN ( MAX ( 'Date'[Date] ), _lastDataDate )
				RETURN
				    MAX ( ( INT ( _end - _start ) + 1 ) * 24, 0 )
			formatString: #,0
			displayFolder: 04 Reliability

		/// Asset downtime caused by the work orders (hours).
		measure 'Downtime Hours' = SUM ( 'Work Orders'[Downtime Hours] )
			formatString: #,0.0
			displayFolder: 04 Reliability

		/// (Asset count x hours in period - downtime) / (asset count x hours in period).
		measure 'Availability %' =
				VAR _capacity = [Asset Count] * [Hours in Period]
				RETURN
				    DIVIDE ( _capacity - [Downtime Hours], _capacity )
			formatString: 0.00%
			displayFolder: 04 Reliability

		/// Mean Time Between Failures = operating hours / number of failure work orders. Higher is better.
		measure 'MTBF (h)' =
				DIVIDE (
				    [Asset Count] * [Hours in Period] - [Downtime Hours],
				    [Failure Work Orders]
				)
			formatString: #,0
			displayFolder: 04 Reliability

		/// Mean Time To Repair = average hours from start to completion of completed failure work orders. Lower is better.
		measure 'MTTR (h)' =
				CALCULATE (
				    AVERAGE ( 'Work Orders'[Repair Hours] ),
				    'Work Orders'[Is Failure] = TRUE (),
				    'Work Orders'[Status] = "Completed"
				)
			formatString: 0.00
			displayFolder: 04 Reliability

		/// Failures x criticality weight (A3/B2/C1) x age factor (1 + age/20) x downtime factor. Only evaluated for a single asset; used for the repair-or-replace list.
		measure 'Asset Risk Score' =
				IF (
				    HASONEVALUE ( 'Asset'[Asset ID] ),
				    VAR _crit = CALCULATE ( SELECTEDVALUE ( 'Asset'[Criticality] ), 'Asset'[Is Current] = TRUE () )
				    VAR _weight = SWITCH ( _crit, "A", 3, "B", 2, "C", 1, 1 )
				    VAR _age = CALCULATE ( SELECTEDVALUE ( 'Asset'[Asset Age] ), 'Asset'[Is Current] = TRUE () )
				    VAR _maxDowntime = MAXX ( ALLSELECTED ( 'Asset'[Asset ID] ), [Downtime Hours] )
				    RETURN
				        [Failure Work Orders] * _weight * ( 1 + DIVIDE ( _age, 20 ) )
				            * ( 1 + DIVIDE ( [Downtime Hours], _maxDowntime ) )
				)
			formatString: 0.0
			displayFolder: 04 Reliability

		/// TCO in the period / replacement value of the asset. >= 1 means repairing costs more than replacing.
		measure 'Cost to Replacement Ratio' =
				IF (
				    HASONEVALUE ( 'Asset'[Asset ID] ),
				    DIVIDE (
				        [Total Cost of Ownership],
				        CALCULATE ( MAX ( 'Asset'[Replacement Value] ), 'Asset'[Is Current] = TRUE () )
				    )
				)
			formatString: 0.00
			displayFolder: 04 Reliability

		/// Cumulative share of downtime by failure description, sorted descending (80/20 analysis).
		measure 'Downtime Pareto Cumulative %' =
				VAR _current = [Downtime Hours]
				VAR _table =
				    ADDCOLUMNS (
				        ALLSELECTED ( 'Failure Code'[Failure Description] ),
				        "@downtime", [Downtime Hours]
				    )
				VAR _cumulative = SUMX ( FILTER ( _table, [@downtime] >= _current ), [@downtime] )
				VAR _total = SUMX ( _table, [@downtime] )
				RETURN
				    IF ( NOT ISBLANK ( _current ), DIVIDE ( _cumulative, _total ) )
			formatString: 0.0%
			displayFolder: 04 Reliability

		/// Share of started work orders whose response time (created -> started) met the priority target (P1 4h, P2 24h, P3 72h, P4 240h).
		measure 'SLA Compliance %' =
				DIVIDE (
				    CALCULATE ( [Work Orders], 'Work Orders'[Is SLA Met] = TRUE () ),
				    CALCULATE ( [Work Orders], NOT ISBLANK ( 'Work Orders'[Started At] ) )
				)
			formatString: 0.0%
			displayFolder: 05 Service

		/// Share of failure work orders fixed at the first visit.
		measure 'First Time Fix %' =
				DIVIDE (
				    CALCULATE ( [Failure Work Orders], 'Work Orders'[First Time Fix] = TRUE () ),
				    [Failure Work Orders]
				)
			formatString: 0.0%
			displayFolder: 05 Service

		/// Preventive / (Preventive + Failure) work orders. World-class benchmark >= 80 %.
		measure 'PM Ratio %' = DIVIDE ( [Preventive Work Orders], [Preventive Work Orders] + [Failure Work Orders] )
			formatString: 0.0%
			displayFolder: 05 Service

		/// Emergency work orders / failure work orders.
		measure 'Emergency Share %' = DIVIDE ( [Emergency Work Orders], [Failure Work Orders] )
			formatString: 0.0%
			displayFolder: 05 Service

		/// Average hours from work order creation to start of work.
		measure 'Avg Response (h)' = AVERAGE ( 'Work Orders'[Response Hours] )
			formatString: 0.0
			displayFolder: 05 Service

		/// Year-to-date maintenance cost.
		measure 'Maintenance Cost YTD' = TOTALYTD ( [Maintenance Cost], 'Date'[Date] )
			formatString: #,0 €
			displayFolder: 06 Time Intelligence

		/// Maintenance cost in the same period of the previous year.
		measure 'Maintenance Cost PY' = CALCULATE ( [Maintenance Cost], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
			formatString: #,0 €
			displayFolder: 06 Time Intelligence

		/// Change vs. same period previous year.
		measure 'Maintenance Cost YoY %' =
				VAR _py = [Maintenance Cost PY]
				RETURN
				    IF ( NOT ISBLANK ( _py ), DIVIDE ( [Maintenance Cost] - _py, _py ) )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: 06 Time Intelligence

		/// Average monthly maintenance cost over the current and two previous months (WINDOW function, requires Year Month on the axis).
		measure 'Maintenance Cost 3M Moving Avg' =
				AVERAGEX (
				    WINDOW ( -2, REL, 0, REL, ALLSELECTED ( 'Date'[Year Month] ), ORDERBY ( 'Date'[Year Month], ASC ) ),
				    [Maintenance Cost]
				)
			formatString: #,0 €
			displayFolder: 06 Time Intelligence

		/// Auto-generated one-paragraph summary for the executive page (replaces manual commentary).
		measure 'Executive Narrative' =
				VAR _cost = [Maintenance Cost]
				VAR _var = [Budget Variance %]
				VAR _sites =
				    ADDCOLUMNS ( VALUES ( 'Site'[Site Name] ), "@var", [Budget Variance %] )
				VAR _worst = TOPN ( 1, _sites, [@var], DESC )
				VAR _worstName = MAXX ( _worst, 'Site'[Site Name] )
				VAR _worstVar = MAXX ( _worst, [@var] )
				VAR _scope = SELECTEDVALUE ( 'Site'[Region], "all regions" )
				RETURN
				    "Maintenance cost for " & _scope & " is "
				        & FORMAT ( DIVIDE ( _cost, 1e6 ), "0.00" ) & " M€, "
				        & FORMAT ( ABS ( _var ), "0.0%" ) & IF ( _var > 0, " above", " below" ) & " budget. "
				        & "Availability is " & FORMAT ( [Availability %], "0.00%" )
				        & " with a PM ratio of " & FORMAT ( [PM Ratio %], "0%" ) & ". "
				        & IF (
				            _worstVar > 0.05,
				            "Attention: " & _worstName & " is " & FORMAT ( _worstVar, "0%" ) & " over budget.",
				            "No site is more than 5% over budget."
				        )
			displayFolder: 07 Storytelling

		/// Page title that reflects the current slicer selection.
		measure 'Dynamic Page Title' =
				"Maintenance performance | "
				    & SELECTEDVALUE ( 'Site'[Region], "All regions" ) & " | "
				    & IF (
				        HASONEVALUE ( 'Date'[Year] ),
				        FORMAT ( VALUES ( 'Date'[Year] ), "0" ),
				        FORMAT ( MIN ( 'Date'[Date] ), "MMM yyyy" ) & " - " & FORMAT ( MAX ( 'Date'[Date] ), "MMM yyyy" )
				    )
			displayFolder: 07 Storytelling

		/// Shows the newest loaded work order so users always know how current the data is.
		measure 'Data Freshness' = "Data as of " & FORMAT ( CALCULATE ( MAX ( 'Work Orders'[Created At] ), REMOVEFILTERS () ), "dd.MM.yyyy HH:mm" )
			displayFolder: 07 Storytelling

		column Value
			dataType: string
			isHidden
			summarizeBy: none
			isNameInferred
			sourceColumn: [Value]

		partition _Measures = calculated
			mode: import
			source = ROW ( "Value", BLANK () )
